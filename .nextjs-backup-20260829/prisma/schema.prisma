generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PaymentType {
  HOURLY
  MONTHLY
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum PayrollFrequency {
  WEEKLY
  MONTHLY
}

enum PayrollStatus {
  DRAFT
  REVIEWED
  FINALISED
}

model Company {
  id             String          @id @default(cuid())
  name           String          @db.VarChar(191)
  address        String          @db.Text
  users          User[]
  employees      Employee[]
  projects       Project[]
  payrollPeriods PayrollPeriod[]
  settings       Settings?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(191)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

model Settings {
  id                      String           @id @default(cuid())
  companyId               String           @unique
  currency                String           @default("EUR") @db.Char(3)
  defaultPayrollFrequency PayrollFrequency @default(WEEKLY)
  company                 Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
}

model Employee {
  id             String            @id @default(cuid())
  companyId      String
  fullName       String            @db.VarChar(191)
  employeeId     String            @unique @db.VarChar(50)
  email          String            @unique @db.VarChar(191)
  phone          String?           @db.VarChar(50)
  paymentType    PaymentType
  hourlyRate     Decimal?          @db.Decimal(12, 2)
  monthlySalary  Decimal?          @db.Decimal(12, 2)
  startDate      DateTime          @db.Date
  status         EmployeeStatus    @default(ACTIVE)
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projectLinks   ProjectEmployee[]
  timesheets     TimesheetEntry[]
  payrollEntries PayrollEntry[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([companyId, status])
  @@index([fullName])
}

model Project {
  id            String            @id @default(cuid())
  companyId     String
  name          String            @db.VarChar(191)
  client        String            @db.VarChar(191)
  location      String            @db.VarChar(191)
  startDate     DateTime          @db.Date
  status        ProjectStatus     @default(ACTIVE)
  notes         String?           @db.Text
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeLinks ProjectEmployee[]
  timesheets    TimesheetEntry[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([companyId, status])
  @@index([name])
}

model ProjectEmployee {
  projectId  String
  employeeId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedAt DateTime @default(now())

  @@id([projectId, employeeId])
  @@index([employeeId])
}

model TimesheetEntry {
  id         String   @id @default(cuid())
  employeeId String
  projectId  String
  date       DateTime @db.Date
  hours      Decimal  @db.Decimal(5, 2)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, projectId, date])
  @@index([employeeId, date])
  @@index([projectId, date])
}

model PayrollPeriod {
  id          String           @id @default(cuid())
  companyId   String
  frequency   PayrollFrequency
  startDate   DateTime         @db.Date
  endDate     DateTime         @db.Date
  payDate     DateTime         @db.Date
  status      PayrollStatus    @default(DRAFT)
  reviewedAt  DateTime?
  finalisedAt DateTime?
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entries     PayrollEntry[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([companyId, frequency, startDate, endDate])
  @@index([companyId, status])
  @@index([startDate, endDate])
}

model PayrollEntry {
  id              String        @id @default(cuid())
  payrollPeriodId String
  employeeId      String
  employeeName    String        @db.VarChar(191)
  employeeNumber  String        @db.VarChar(50)
  paymentType     PaymentType
  hoursWorked     Decimal       @default(0) @db.Decimal(8, 2)
  hourlyRate      Decimal?      @db.Decimal(12, 2)
  monthlySalary   Decimal?      @db.Decimal(12, 2)
  grossPay        Decimal       @db.Decimal(12, 2)
  paye            Decimal       @default(0) @db.Decimal(12, 2)
  usc             Decimal       @default(0) @db.Decimal(12, 2)
  prsi            Decimal       @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(12, 2)
  netPay          Decimal       @db.Decimal(12, 2)
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payslip         Payslip?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId])
  @@index([payrollPeriodId])
}

model Payslip {
  id             String       @id @default(cuid())
  payrollEntryId String       @unique
  fileName       String       @db.VarChar(191)
  generatedAt    DateTime     @default(now())
  payrollEntry   PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)
}
